# ============================================================================
#  Configuration du serveur Innofaso NC
#  Copier ce fichier en « .env » puis adapter les valeurs.
#     cp .env.example .env
# ============================================================================

# --- Base de données --------------------------------------------------------
# DB_DRIVER : "mysql" pour utiliser MySQL, "memoire" pour la base en RAM (démo).
DB_DRIVER=mysql

DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=innofaso_nc

# --- Serveur ----------------------------------------------------------------
PORT=4000

# URL du frontend (utilisée dans les emails de transfert de fiche)
APP_URL=http://localhost:5173

# Intervalle du planificateur de rappels CAPA (en millisecondes).
# Laisser vide = 1 passage par jour. Pour une démo : 60000 = chaque minute.
# DEMO_INTERVAL_MS=60000

# --- SMS --------------------------------------------------------------------
# SMS_PROVIDER : "mock" (par défaut), "emailjs" (emails réels gratuits) ou "twilio".
SMS_PROVIDER=emailjs

# --- EmailJS (gratuit, 200 emails/mois) ------------------------------------
EMAILJS_SERVICE_ID=service_5kbp4ir
EMAILJS_TEMPLATE_ID=template_95st7rv
EMAILJS_PUBLIC_KEY=Mk0iHSj836JfhJw0F
EMAILJS_PRIVATE_KEY=xlIutk0uLwimpODEUrq44

# --- Twilio (optionnel, remplace EmailJS pour de vrais SMS) ----------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- JWT (authentification) --------------------------------------------------
JWT_SECRET=innofaso_secret_key_2026_production_changeme
JWT_REFRESH_SECRET=innofaso_refresh_secret_key_2026_production_changeme
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- Authentification --------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15